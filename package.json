{
  "name": "tsuglyph",
  "version": "1.0.0",
  "description": "Universal Gamepad Button Overlay for PC Games and Emulators",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development node scripts/run-electron.js\"",
    "build:vite": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:vite && npm run build:main",
    "start": "npm run build && node scripts/run-electron.js",
    "package": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "gamepad",
    "controller",
    "overlay",
    "emulator",
    "dualsense",
    "xbox",
    "dolphin",
    "n64",
    "pcsx2"
  ],
  "author": "TsuGlyph Team",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "koffi": "^3.3.8",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.tsuglyph.overlay",
    "productName": "TsuGlyph",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
